<?xml version="1.0"?>
<session license="CC0" duration="3600">
  <modules>
    <route name="L" channels="1" connect="system:capture_2">
      <plugins>
        <feedbackdelay f="50" feedback="0.9"/>
        <level2osc sendwhilestopped="true" tau="0.2" path="/field" url="osc.udp://localhost:9877"/>
        <level2osc sendwhilestopped="true" firstpar="70" tau="0.05" mode="rms" path="/tone/ap0/sawtooth/af" url="osc.udp://localhost:9877"/>
      </plugins>
    </route>
    <route name="tone" channels="1" connect_out="system:playback_1">
      <plugins>
	<sawtooth a="0" fscale="1800"/>
      </plugins>
    </route>
    <datalogging>
      <osc path="/field" size="2" ignorefirst="true"/>
      <osc path="/obj0" size="3"/>
    </datalogging>
    <system command="../build/detect_and_send_markers -d=10 -l=2.54 --ci=4 -c=camera.calib --url=osc.udp://localhost:9877/ --fmt=/obj%d --norot --smooth=0"/>
  </modules>
</session>
